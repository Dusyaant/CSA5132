#include <stdio.h>

int main() {
    int key[2][2] = {{9, 4}, {5, 7}};
    int msg[2] = {12, 4}; // "me" (m=12, e=4)
    int cipher[2];
    
    cipher[0] = (key[0][0]*msg[0] + key[0][1]*msg[1]) % 26;
    cipher[1] = (key[1][0]*msg[0] + key[1][1]*msg[1]) % 26;
    
    printf("Encrypted pair: %d %d\n", cipher[0], cipher[1]);
    return 0;
}
